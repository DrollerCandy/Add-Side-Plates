<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>AddSidePlates</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<Version>1.0.0</Version>
		<OutputPath>$(MSBuildProjectDirectory)/../release/AddSidePlates/</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>None</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
	</PropertyGroup>

	<ItemGroup>
		<None Include="config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<PackageReference Include="SPTushonka.Common" Version="4.1.5" />
		<PackageReference Include="SPTushonka.DI" Version="4.1.5" />
		<PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
		<PackageReference Include="WTT-ServerCommonLib" Version="3.*" ExcludeAssets="runtime" />
	</ItemGroup>
</Project>
